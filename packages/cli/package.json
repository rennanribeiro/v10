{
  "name": "@videojs/cli",
  "version": "10.0.0-beta.32",
  "description": "Inspect Video.js documentation and add editable UI source",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/videojs/v10.git",
    "directory": "packages/cli"
  },
  "bin": "./dist/index.mjs",
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
