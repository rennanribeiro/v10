    "oxc-parser": "0.146.0",
    "oxc-walker": "^1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "site": "workspace:*",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
