---
import { getCollection } from 'astro:content';

import Li from '@/components/typography/Li.astro';
import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import Ul from '@/components/typography/Ul.astro';

/**
 * The media bundles the current release ships under `cdn/media/`, read from the
 * generated CDN media manifest so the page enumerates the real build output
 * instead of a hand-maintained list.
 */
const bundles = (await getCollection('cdnMedia')).map((entry) => entry.id).sort();
---

<Ul>
  {
    bundles.map((id) => (
      <Li>
        <MarkdownCode>media/{id}.js</MarkdownCode>
      </Li>
    ))
  }
</Ul>
